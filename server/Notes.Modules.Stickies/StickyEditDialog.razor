<MudDialog Style="@($"background:{NoteColors.Background(_color)};color:{NoteColors.NoteText}")" Class="notes-sticky-dialog">
    <DialogContent>
        <MudTextField @bind-Value="_title" Placeholder="Titel" Variant="Variant.Text" Underline="false"
                      Class="notes-sticky-title" Immediate="true" />
        <MudTextField @bind-Value="_content" Placeholder="Notiz …" Variant="Variant.Text" Underline="false"
                      Lines="6" Sizing="InputSizing.Auto" MaxLines="30" Immediate="true" AutoFocus="true" />
        <div class="d-flex align-center flex-wrap gap-1 mt-3">
            @foreach (var c in StickyColors.All)
            {
                <button type="button" title="@NoteColors.Label(c)" class="notes-swatch @(c == _color ? "selected" : "")"
                        style="background:@NoteColors.Background(c)" @onclick="() => _color = c"></button>
            }
            <MudSpacer />
            <MudToggleIconButton @bind-Toggled="_pinned" Icon="@Icons.Material.Outlined.PushPin" ToggledIcon="@Icons.Material.Filled.PushPin"
                                 Style="@($"color:{NoteColors.NoteText}")" title="Anpinnen" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="mr-auto ml-4" Style="@($"color:{NoteColors.NoteText};opacity:.6")">Strg+Enter speichert</MudText>
        <MudButton OnClick="() => Dialog.Cancel()" Style="@($"color:{NoteColors.NoteText}")">Abbrechen</MudButton>
        <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Dark">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public sealed record Result(string? Title, string Content, string Color, bool Pinned);

    [CascadingParameter] public required IMudDialogInstance Dialog { get; set; }
    [Parameter] public Sticky? Sticky { get; set; }

    private string? _title;
    private string _content = "";
    private string _color = StickyColors.Default;
    private bool _pinned;

    protected override void OnInitialized()
    {
        if (Sticky is null) return;
        _title = Sticky.Title;
        _content = Sticky.Content;
        _color = Sticky.Color;
        _pinned = Sticky.Pinned;
    }

    private void Save() => Dialog.Close(DialogResult.Ok(new Result(string.IsNullOrWhiteSpace(_title) ? null : _title.Trim(), _content, _color, _pinned)));

    public static async Task<Result?> ShowAsync(IDialogService dialogs, Sticky? sticky)
    {
        var reference = await dialogs.ShowAsync<StickyEditDialog>(null,
            new DialogParameters<StickyEditDialog> { { x => x.Sticky, sticky } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true, NoHeader = true });
        var result = await reference.Result;
        return result is { Canceled: false, Data: Result r } ? r : null;
    }
}
