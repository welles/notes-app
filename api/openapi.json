{
  "openapi": "3.1.1",
  "info": {
    "title": "Notes API",
    "description": "Generic sync protocol of Notes. Rules: changes are additive only; unknown fields and enum values must be preserved.",
    "version": "1"
  },
  "paths": {
    "/api/meta": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Server version, supported protocol versions, known entity types and capabilities.",
        "operationId": "GetMeta",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sync/events": {
      "get": {
        "tags": [
          "Sync"
        ],
        "summary": "Server-Sent Events: 'changed' with the latest version whenever data changes; comment heartbeats every 25 s.",
        "operationId": "SyncEvents",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/export": {
      "get": {
        "tags": [
          "Export"
        ],
        "summary": "All non-deleted entities of all modules as JSON, grouped by entity type.",
        "operationId": "ExportAll",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/sync/changes": {
      "get": {
        "tags": [
          "Sync"
        ],
        "summary": "Changes of all entity types since a cursor, ordered by version.",
        "description": "If fullResyncRequired is true, the client must reload everything (since=0) while keeping its outbox.",
        "operationId": "PullChanges",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PullResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sync/push": {
      "post": {
        "tags": [
          "Sync"
        ],
        "summary": "Applies client changes atomically; returns a result and the resulting server state per entry.",
        "operationId": "PushChanges",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConflictWinner": {
        "enum": [
          "client",
          "server",
          null
        ]
      },
      "ContextData": {
        "required": [
          "name",
          "color",
          "position",
          "id",
          "createdAt",
          "modifiedAt",
          "deletedAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional accent colour. Unknown values must be preserved."
          },
          "position": {
            "type": "number",
            "format": "double"
          },
          "id": {
            "type": "string",
            "description": "UUIDv7, generated by the client.",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "description": "UTC, ISO-8601 with milliseconds.",
            "format": "date-time"
          },
          "modifiedAt": {
            "type": "string",
            "description": "Time of the last change on the client that made it.",
            "format": "date-time"
          },
          "deletedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Tombstone timestamp, null if not deleted.",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "description": "Server-assigned global change number. Ignored on push.",
            "format": "int64"
          }
        },
        "description": "data of entity type core.context"
      },
      "EntityRef": {
        "required": [
          "entityType",
          "id"
        ],
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "JsonObject": {
        "type": "object"
      },
      "MetaResponse": {
        "required": [
          "serverVersion",
          "protocol",
          "entityTypes",
          "capabilities",
          "minClientVersion"
        ],
        "type": "object",
        "properties": {
          "serverVersion": {
            "type": "string"
          },
          "protocol": {
            "$ref": "#/components/schemas/ProtocolRange"
          },
          "entityTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minClientVersion": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ProtocolRange": {
        "required": [
          "min",
          "max"
        ],
        "type": "object",
        "properties": {
          "min": {
            "type": "integer",
            "format": "int32"
          },
          "max": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PullResponse": {
        "required": [
          "changes",
          "cursor",
          "hasMore",
          "fullResyncRequired"
        ],
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncEnvelope"
            }
          },
          "cursor": {
            "type": "integer",
            "format": "int64"
          },
          "hasMore": {
            "type": "boolean"
          },
          "fullResyncRequired": {
            "type": "boolean"
          }
        }
      },
      "PushEntryResult": {
        "required": [
          "entityType",
          "id",
          "status"
        ],
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/PushStatus"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "winner": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ConflictWinner"
              }
            ]
          },
          "conflictCopy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EntityRef"
              }
            ]
          },
          "server": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SyncEnvelope"
              }
            ]
          }
        }
      },
      "PushEnvelope": {
        "required": [
          "entityType",
          "id",
          "baseVersion",
          "modifiedAt",
          "deleted",
          "data"
        ],
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "baseVersion": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "deleted": {
            "type": "boolean"
          },
          "data": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonObject"
              }
            ]
          }
        }
      },
      "PushRequest": {
        "required": [
          "changes"
        ],
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PushEnvelope"
            },
            "description": "Changes to apply as a whole, in one transaction."
          }
        }
      },
      "PushResponse": {
        "required": [
          "results"
        ],
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PushEntryResult"
            }
          }
        }
      },
      "PushStatus": {
        "enum": [
          "accepted",
          "conflict",
          "rejected"
        ]
      },
      "StickyData": {
        "required": [
          "contextId",
          "title",
          "content",
          "color",
          "pinned",
          "position",
          "id",
          "createdAt",
          "modifiedAt",
          "deletedAt",
          "version"
        ],
        "type": "object",
        "properties": {
          "contextId": {
            "type": "string",
            "description": "Context the post-it belongs to.",
            "format": "uuid"
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "content": {
            "type": "string",
            "description": "Plaintext, line breaks preserved."
          },
          "color": {
            "type": "string",
            "description": "yellow, green, blue, pink, purple, orange, gray. Unknown values must be preserved and displayed as yellow."
          },
          "pinned": {
            "type": "boolean"
          },
          "position": {
            "type": "number",
            "description": "Ascending manual order.",
            "format": "double"
          },
          "id": {
            "type": "string",
            "description": "UUIDv7, generated by the client.",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "description": "UTC, ISO-8601 with milliseconds.",
            "format": "date-time"
          },
          "modifiedAt": {
            "type": "string",
            "description": "Time of the last change on the client that made it.",
            "format": "date-time"
          },
          "deletedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "Tombstone timestamp, null if not deleted.",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "description": "Server-assigned global change number. Ignored on push.",
            "format": "int64"
          }
        },
        "description": "data of entity type stickies.sticky"
      },
      "SyncEnvelope": {
        "required": [
          "entityType",
          "id",
          "version",
          "deleted",
          "data"
        ],
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "deleted": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/JsonObject"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Meta"
    },
    {
      "name": "Sync"
    },
    {
      "name": "Export"
    }
  ]
}