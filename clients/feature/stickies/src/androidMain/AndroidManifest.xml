<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name="dev.welles.notes.feature.stickies.widget.SingleStickyWidgetReceiver" android:exported="true" android:label="Post-it">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sticky_single_widget" />
        </receiver>
        <receiver android:name="dev.welles.notes.feature.stickies.widget.PinnedStickiesWidgetReceiver" android:exported="true" android:label="Angepinnte Post-its">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sticky_pinned_widget" />
        </receiver>
        <activity
            android:name="dev.welles.notes.feature.stickies.widget.PinnedStickiesWidgetConfigActivity"
            android:exported="true"
            android:label="Angepinnte Post-its"
            android:theme="@style/Theme.Notes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name="dev.welles.notes.feature.stickies.widget.SingleStickyWidgetConfigActivity"
            android:exported="true"
            android:label="Post-it auswählen"
            android:theme="@style/Theme.Notes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
